# Public build-time configuration only. Values with EXPO_PUBLIC_ or VITE_ are bundled into clients.
VITE_API_URL=https://eldercare-api-vaee.onrender.com
VITE_OAUTH_PORTAL_URL=
EXPO_PUBLIC_API_BASE_URL=https://eldercare-api-vaee.onrender.com
EXPO_PUBLIC_OAUTH_PORTAL_URL=
EXPO_PUBLIC_OAUTH_SERVER_URL=
EXPO_PUBLIC_APP_ID=
EAS_PROJECT_ID=
# Set these as EAS file-type build variables (or use ignored local files under firebase/).
GOOGLE_SERVICES_JSON_FILE=
GOOGLE_SERVICE_INFO_PLIST_FILE=
PUBLIC_DOWNLOAD_URL=

# Render server runtime: current Manus OAuth/session and database adapter.
MANUS_PROJECT_ID=
VITE_APP_ID=
MANUS_OAUTH_API_URL=
OAUTH_SERVER_URL=
MANUS_OAUTH_PORTAL_URL=
MANUS_JWT_SECRET=
JWT_SECRET=
OWNER_OPEN_ID=
DATABASE_URL=

# Browser CORS allowlist (exact HTTPS origins, no paths; comma-separate Pages + custom domain).
PUBLIC_APP_URL=
PUBLIC_APP_URLS=

# Firebase Admin values are server-only; they enable ID-token verification and account-profile bootstrap.
# They do not implement care records, consented family linking, FCM, SOS, or other care workflows.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Private media / optional server adapters. Never set these as EXPO_PUBLIC_* or on Cloudflare Pages.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=eldercare-media
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_ACCESS_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VOICE_FROM=
EXOTEL_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
GOOGLE_MAPS_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
