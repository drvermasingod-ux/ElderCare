rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Profiles, invitation hashes/phone bindings, family relationships, location-sharing
    // preferences/latest points/rate limits, audit events, and care records are accessed only by
    // the verified server. Firebase Admin SDK requests bypass these client rules; native clients
    // receive no direct collection access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
